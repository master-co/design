{
  "name": "@master/design-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-site": "node --import tsx scripts/prepare.ts",
    "dev": "bun run prepare-site && astro dev",
    "build": "bun run prepare-site && astro build",
    "preview": "wrangler pages dev out",
    "type-check": "bun run prepare-site && astro sync && astro-check --tsconfig tsconfig.json && svelte-check --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@master/internal-site": "0.2.12",
    "@master/ui": "0.0.5",
    "@master/css": "2.1.3",
    "@master/css-astro": "2.1.3",
    "@master/css-compiler": "2.1.3",
    "@master/css-tooling": "2.1.3",
    "@master/css-schema": "2.1.3",
    "@master/css-preset": "2.1.3",
    "@master/css-language-service": "2.1.3",
    "@tabler/icons-svelte-runes": "3.50.0",
    "astro": "7.4.2",
    "clsx": "2.1.1",
    "svelte": "5.57.2",
    "vite": "8.3.5",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "@master/css-server": "2.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "svelte-check": "4.7.7",
    "wrangler": "4.129.0",
    "@astrojs/svelte": "9.1.2"
  }
}
