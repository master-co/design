---
import Doc from '@master/internal-site/layouts/Doc.astro'
import { footerProps } from '../navigation'
import categories from '../.categories/guide.json'
---
<div id="main-content" tabindex="-1" class="design-document">
  <details class="design-compact-nav">
    <summary>Browse the guide</summary>
    <nav aria-label="Guide navigation">
      {categories.map(category => <section><h2>{category.name}</h2><ul>{category.pages.map(page => <li><a href={page.pathname} aria-current={Astro.url.pathname === page.pathname ? 'page' : undefined}>{page.other?.subject ?? page.title}</a></li>)}</ul></section>)}
    </nav>
  </details>
  <Doc {...Astro.props as any} {footerProps}><slot /></Doc>
</div>
