/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The production alias and every immutable deployment URL on pages.dev serve the canonical site's content;
# keep both host shapes out of search indexes without affecting design.master.co. Site delivery requires it.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:deployment.:project.pages.dev/*
  X-Robots-Tag: noindex
