---
import Demo from '@master/internal-site/demo/Demo.svelte'
import DesignLab from './DesignLab.svelte'
import TaskStudy from './TaskStudy.svelte'
import FoundationPreview from './FoundationPreview.svelte'
import { figureById } from '../figures/catalog.mjs'
import '../styles/figures.css'
const { id } = Astro.props
const entry = figureById(id)
const titles: Record<string, string> = {
  color: 'Inspect a composited color pair', density: 'Measure the target independently',
  geometry: 'Inspect a circular inset', typography: 'Let real text change the layout',
  states: 'Keep selection and focus distinct', responsive: 'Recompose a reading region',
  async: 'Resolve requests out of order', motion: 'Reverse motion before it finishes',
  reading: 'Explore a local reading collection', service: 'Complete a local request',
  workspace: 'Manage a local collection',
}
if (!['DesignLab', 'TaskStudy', 'FoundationPreview'].includes(entry.component)) throw new Error(`Not an interactive study: ${id}`)
const title = entry.title ?? (entry.component === 'FoundationPreview' ? 'Apply a density change coherently' : titles[entry.kind!])
---
<Demo title={title} frameClassName="design-study-frame" data-study-frame={id} aria-label={title} padding="sm" align="start">
  {entry.component === 'DesignLab' && <DesignLab kind={entry.kind!} client:load />}
  {entry.component === 'TaskStudy' && <TaskStudy kind={entry.kind!} client:load />}
  {entry.component === 'FoundationPreview' && <FoundationPreview client:load />}
  <Fragment slot="caption">{entry.component === 'TaskStudy' ? 'Local data and simulated outcomes. Follow the acceptance walkthrough in the guide, including interruption and recovery.' : 'Observe the rendered relationship as you change the controls. Example values describe this specimen; use the surrounding guide to choose values for your project.'}</Fragment>
</Demo>
