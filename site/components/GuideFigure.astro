---
import Demo from '@master/internal-site/demo/Demo.svelte'
import { figureById } from '../figures/catalog.mjs'
import '../styles/figures.css'
import { descriptions } from '../figures/descriptions.mjs'
const { id } = Astro.props
const figure = figureById(id)
const kinds = ['flow', 'branch', 'comparison', 'painted-geometry', 'target', 'color', 'type', 'spacing', 'geometry', 'layers', 'responsive', 'localization', 'chart', 'field', 'surface', 'image', 'metrics', 'states', 'material', 'avatars', 'scroll']
if (!kinds.includes(figure.kind!)) throw new Error(`Missing figure renderer for ${figure.kind}`)
const kind = figure.kind
---
<Demo title={figure.title} frameClassName="design-figure" data-figure={id} aria-label={figure.title} padding="sm" align="start">
  <div class={`df-stage df-kind-${kind}`}>
    {(kind === 'flow' || kind === 'comparison') && <ol class="df-panels" style={`--df-panel-count:${figure.panels?.length ?? 1}`}>{figure.panels?.map((panel, index) => <li>
      <span class="df-label">{kind === 'flow' && <span class="df-step">{String(index + 1).padStart(2, '0')}</span>}{panel.label}</span>
      <strong class="df-value">{panel.value}</strong><span class="df-note">{panel.note}</span>
    </li>)}</ol>}
    {kind === 'branch' && <div class="df-branch">
      <div class="df-branch-origin"><span class="df-label">{figure.panels![0].label}</span><strong class="df-value">{figure.panels![0].value}</strong><span class="df-note">{figure.panels![0].note}</span></div>
      <p class="df-branch-relation">↓ {id === 'bulk-outcomes' ? 'Per-item outcomes' : 'Possible outcomes'}</p>
      <ul class="df-branches">{figure.panels!.slice(1).map(panel => <li><span class="df-label">{panel.label}</span><strong class="df-value">{panel.value}</strong><span class="df-note">{panel.note}</span></li>)}</ul>
    </div>}
    {kind === 'target' && <div class="df-pair"><div><div class="df-target" aria-hidden="true"><span>+</span></div><p><strong>16px mark</strong><br />44px target</p></div><div class="df-note"><p>The dotted boundary is the interactive area.</p><p>Neighboring targets must not overlap, even when their visible marks are far apart.</p></div></div>}
    {kind === 'color' && <div class="df-color-map"><div class="df-color-surface"><span class="df-label">Surface</span><strong>Content</strong><span class="df-color-boundary">Boundary</span><span class="df-color-focus">Focus</span><span>✓ Status has a text cue</span></div><dl><dt>Role</dt><dd>What the color communicates</dd><dt>Value</dt><dd>What the current theme renders</dd><dt>Pair</dt><dd>The actual foreground and background</dd></dl></div>}
    {kind === 'type' && <div class="df-pair"><div class="df-reading"><span class="df-label">Reading sequence</span><strong class="df-headline">A useful place to begin</strong><p>A coherent measure keeps the next line close enough to find. Space marks the next thought.</p><a href="/foundations/layout">Read about composition →</a></div><div><span class="df-label">Scanning aligned values</span><dl class="df-records"><dt>Field notes</dt><dd>1,240.50</dd><dt>Research</dt><dd>82.00</dd><dt>Archive</dt><dd>9,508.12</dd></dl><p class="df-note">Equal-width figures help compare values; prose keeps its reading rhythm.</p></div></div>}
    {kind === 'spacing' && <div class="df-pair">{[false, true].map(grouped => <div><span class="df-label">{grouped ? 'Distinct relationships' : 'Equal gaps'}</span><div class:list={['df-field-groups', { grouped }]}>{['Project name', 'Owner'].map(label => <div><span>{label}</span><div class="df-input-shape">{label === 'Owner' ? 'Maya Chen' : 'Field notes'}</div><small>{label === 'Owner' ? 'Receives updates' : 'Visible to the team'}</small></div>)}</div><p class="df-note">{grouped ? '8px within · 24px between' : '16px between each element'}</p></div>)}</div>}
    {kind === 'geometry' && <div class="df-pair">{[24, 16].map(radius => <div><span class="df-label">{radius === 24 ? 'Same radius' : 'Coordinated circular inset'}</span><svg viewBox="0 0 200 184" role="img" aria-label={`Outer radius 24, inset 8, inner radius ${radius}; schematic geometry`}><rect x="12" y="12" width="176" height="160" rx="48" class="df-svg-shell"/><rect x="28" y="28" width="144" height="128" rx={radius * 2} class="df-svg-insert"/><path d="M12 75H28M20 67V83" class="df-svg-measure"/><circle cx="60" cy="60" r="3" class="df-svg-dot"/><path d="M60 60V12M60 60H12" class="df-svg-guide"/></svg><p class="df-note">Outer R24 · inset 8 · inner R{radius}<br />Schematic · values in CSS px</p></div>)}</div>}
    {kind === 'painted-geometry' && <div class="df-pair">{[false, true].map(painted => <div><span class="df-label">{painted ? 'Add an outside ring' : 'Layout inset only'}</span><svg class="df-inset-svg" viewBox="0 0 200 184" role="img" aria-label={painted ? 'The layout gap stays 8, while a half-pixel ring leaves a painted gap of 7.5' : 'The inner surface starts 8 CSS pixels inside the outer surface'}><rect x="12" y="12" width="176" height="160" rx="48" class="df-svg-shell"/>{painted && <rect x="27" y="27" width="146" height="130" rx="33" fill="currentColor"/>}<rect x="28" y="28" width="144" height="128" rx="32" fill="var(--color-surface-inset)"/><path d="M12 92H28M12 85V99M28 85V99" class="df-svg-measure"/>{painted && <path d="M27 73H173" class="df-svg-guide"/>}</svg><p class="df-note">Layout inset: 8px<br />{painted ? 'Outside ring: .5px · painted gap: 7.5px' : 'No ring · visible gap: 8px'}<br />Schematic · values in CSS px</p></div>)}</div>}
    {kind === 'layers' && <div class="df-layer-stack"><div><span class="df-label">Grouping</span><strong>Related content</strong><p>Space and alignment can connect it.</p></div><div><span class="df-label">Painted depth</span><strong>A separate surface</strong><p>Fill, contour and shadow explain appearance.</p></div><div><span class="df-label">Interaction layer</span><strong>A blocking decision</strong><p>Modality and focus come from behavior.</p></div></div>}
    {kind === 'responsive' && <div class="df-pair"><div><span class="df-label">Room for a rail</span><div class="df-page wide"><div class="df-page-header">Title and introduction</div><div class="df-page-main">Main reading region<br /><span class="df-lines" aria-hidden="true"></span></div><div class="df-page-rail">Contents<br />1. Purpose<br />2. Details</div><div class="df-page-action">Next useful action</div></div></div><div><span class="df-label">Narrow composition</span><div class="df-page narrow"><div class="df-page-header">Title and introduction</div><div class="df-page-rail">Contents ▾</div><div class="df-page-main">Main reading region<br /><span class="df-lines" aria-hidden="true"></span></div><div class="df-page-action">Next useful action</div></div></div></div>}
    {kind === 'localization' && <div class="df-pair"><div lang="en" dir="ltr"><span class="df-label">Left to right</span><div class="df-locale-row"><span>Report</span><bdi>notes-2026.pdf</bdi></div><div class="df-locale-row"><span>Next</span><span>→</span></div></div><div lang="ar" dir="rtl"><span class="df-label">من اليمين إلى اليسار</span><div class="df-locale-row"><span>تقرير</span><bdi>notes-2026.pdf</bdi></div><div class="df-locale-row"><span>التالي</span><span>←</span></div></div></div>}
    {kind === 'chart' && <div class="df-pair">{[0, 70].map(base => <div><span class="df-label">Baseline {base}</span><div class="df-chart">{[80, 90].map((value, index) => <div><span>{index === 0 ? 'A' : 'B'}</span><span class="df-bar-track"><span style={`width:${(value - base) / (100 - base) * 100}%`}></span></span><strong>{value}</strong></div>)}</div><div class="df-axis"><span>{base}</span><span>100</span></div><p class="df-note">{base === 0 ? 'Lengths retain the magnitude ratio.' : 'Lengths exaggerate the difference.'}</p></div>)}</div>}
    {kind === 'field' && <div class="df-field-anatomy"><div><span class="df-label">01 · Label</span><strong>Email address</strong></div><div><span class="df-label">02 · Value</span><span class="df-input-shape">maya@</span></div><div><span class="df-label">03 · Persistent help</span><span>We will send the confirmation here.</span></div><div><span class="df-label">04 · Correction</span><span>! Enter a complete email address.</span></div><p class="df-note">Schematic field anatomy; this drawing is not an input.</p></div>}
    {kind === 'surface' && <div class="df-triple">{['Contour', 'Contact', 'Diffuse'].map((name, i) => <div><span class="df-label">{name}</span><div class={`df-surface-sample part-${i}`}><span>Same bounds</span></div><p class="df-note">{['Perimeter definition', 'Local attachment', 'Broader separation'][i]}</p></div>)}</div>}
    {kind === 'image' && <div class="df-pair">{[false, true].map(outline => <div><span class="df-label">{outline ? 'Inward contour' : 'Image only'}</span><div class:list={['df-image', { outlined: outline }]}><svg viewBox="0 0 300 160" role="img" aria-label="Original schematic landscape"><rect width="300" height="160" fill="#e7e9e7"/><path d="M0 110L80 30 170 115 240 55 300 100V160H0Z" fill="#a1aaa3"/><path d="M0 135L110 80 215 142 300 95V160H0Z" fill="#53675e"/></svg></div><p class="df-note">Same source · crop · bounds</p></div>)}</div>}
    {kind === 'metrics' && <div><div class="df-metrics"><span>Ag 012</span><span lang="zh-Hant">文字 012</span><span lang="ja">かな 012</span></div><p class="df-note">Dotted line: shared line box · short solid marker: actual inline baseline. Actual glyph metrics depend on the loaded font.</p></div>}
    {kind === 'states' && <div class="df-triple">{['Selected', 'Focused', 'Selected + focused'].map((name, i) => <div><span class="df-label">{name}</span><div class:list={['df-state', { selected: i !== 1, focused: i !== 0 }]}><span>{i !== 1 ? '✓ ' : ''}Field notes</span></div></div>)}</div>}
    {kind === 'material' && <div class="df-pair">{[false, true].map(pattern => <div><span class="df-label">{pattern ? 'Detailed backdrop' : 'Plain backdrop'}</span><div class:list={['df-backdrop', { pattern }]}><div>Foreground information<br /><small>Readability depends on this pair.</small></div></div></div>)}</div>}
    {kind === 'avatars' && <div class="df-pair"><div><span class="df-label">Compact identification</span><div class="df-avatar-stack" aria-label="Maya, Eli, Jo and two more people"><span>MC</span><span>ER</span><span>JL</span><span>+2</span></div><p class="df-note">Overlap reduces occupied width.</p></div><div><span class="df-label">Reachable people</span><ul class="df-people"><li>Maya Chen</li><li>Eli Rivera</li><li>Jo Lee</li><li>Two more participants</li></ul><p class="df-note">A complete list preserves identities.</p></div></div>}
    {kind === 'scroll' && <div class="df-pair">{[false, true].map(offset => <div><span class="df-label">{offset ? 'Destination has clearance' : 'Destination is obscured'}</span><div class="df-scroll-example"><div class="df-sticky">Sticky navigation</div><div class:list={['df-scroll-heading', { offset }]}>{offset ? 'Visible heading' : 'Covered heading'}</div><span class="df-lines" aria-hidden="true"></span></div><p class="df-note">{offset ? 'Check the offset after text grows.' : 'The heading exists inside the viewport.'}</p></div>)}</div>}
  </div>
  <Fragment slot="caption">
    <p class="df-caption">{figure.caption}</p>
    <details class="df-description"><summary>Text description</summary>
      {figure.panels?.length ? <ul>{figure.panels.map(panel => <li><strong>{panel.label}: {panel.value}.</strong> {panel.note}</li>)}</ul> : <p>{descriptions[kind as keyof typeof descriptions]}</p>}
    </details>
  </Fragment>
</Demo>
