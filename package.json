{
  "name": "@master/design-skills",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "husky",
    "build": "bun build examples/interface-craft/app.ts examples/interface-craft/avatar/client.ts examples/interface-craft/typography-layout/client.ts --root examples/interface-craft --target browser --outdir examples/interface-craft/dist && node scripts/build.mjs",
    "demo": "node scripts/serve.mjs",
    "check": "bun run --cwd site prepare-site && node scripts/check.mjs && node scripts/release.mjs check && node scripts/site-delivery-check.mjs && tsc --noEmit && node --test tests/*.test.mjs",
    "release:plan": "node scripts/release.mjs plan",
    "release:pack": "node scripts/release.mjs pack",
    "capture": "node scripts/capture.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:native": "node scripts/native-check.mjs",
    "test:install": "node scripts/install-check.mjs",
    "test:forward": "node docs/verification/brand/output/verify.mjs && node docs/verification/near-white/output/verify.mjs",
    "test:dashboard": "node scripts/dashboard-check.mjs",
    "capture:avatars": "node scripts/avatar-capture.mjs",
    "test:avatars": "node scripts/avatar-check.mjs",
    "capture:typography": "node scripts/typography-capture.mjs",
    "test:typography": "node scripts/typography-check.mjs",
    "test:reading": "node scripts/reading-controls-check.mjs",
    "dev": "bun run --cwd site dev",
    "build:site": "bun run --cwd site build",
    "build:site:cloudflare-pages": "bash scripts/build-site-hosted.sh",
    "check:site": "bun run --cwd site type-check && node --test tests/site.test.mjs",
    "test:site": "node scripts/site-browser-check.mjs",
    "check:site-pins": "node scripts/check-site-pins.mjs",
    "check:site-delivery": "node scripts/site-delivery-check.mjs",
    "test:site-delivery": "node --test tests/pages-site-manifest.test.mjs tests/pages-site-release.test.mjs tests/pages-release-github.test.mjs tests/pages-release-target.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.2",
    "aronrepo": "4.0.2",
    "husky": "9.1.7",
    "linkedom": "^0.18.14",
    "sharp": "0.35.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "yaml": "^2.8.0"
  },
  "workspaces": [
    "site"
  ]
}
