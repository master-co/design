ort '+(open?'open':'closed');e.currentTarget.setAttribute('aria-expanded',String(open));e.currentTarget.textContent=open?'Close details':'Open details'};</script></html>+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
