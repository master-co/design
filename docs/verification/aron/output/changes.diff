+  </style>
+</head>
+<body>
+  <main>
+    <h1>Interface library</h1>
+    <section class="card" data-open="true" aria-label="Library controls">
+      <div class="number-row">
+        <output id="elapsed" class="number" aria-live="polite" aria-atomic="true" aria-describedby="elapsed-label">11:11</output>
+        <span id="elapsed-label" class="number-label">elapsed</span>
+      </div>
+      <div class="controls">
+        <button id="value" type="button" disabled>Next value</button>
+        <button id="toggle" type="button" aria-expanded="true" aria-controls="panel" hidden>Close details</button>
+      </div>
+      <div class="viewport">
+        <div class="panel-clip">
+          <div id="panel" class="panel" role="region" aria-labelledby="panel-title">
+            <p id="panel-title" class="panel-title">Project brief</p>
+            <p class="panel-copy">Layout review</p>
+          </div>
+        </div>
+      </div>
+      <noscript><p class="fallback">Enable JavaScript to change the elapsed value.</p></noscript>
+    </section>
+  </main>
+  <script>
+    const values = ['11:11', '08:08', '12:34'];
+    const card = document.querySelector('.card');
+    const valueButton = document.querySelector('#value');
+    const toggleButton = document.querySelector('#toggle');
+    const elapsed = document.querySelector('#elapsed');
+    const panel = document.querySelector('#panel');
+    let tick = 0;
+    let open = false;
+
+    function renderDetails() {
+      card.dataset.open = String(open);
+      toggleButton.setAttribute('aria-expanded', String(open));
+      toggleButton.textContent = open ? 'Close details' : 'Open details';
+      panel.inert = !open;
+      panel.setAttribute('aria-hidden', String(!open));
+    }
+
+    renderDetails();
+    valueButton.disabled = false;
+    toggleButton.hidden = false;
+    valueButton.addEventListener('click', () => {
+      tick = (tick + 1) % values.length;
+      elapsed.value = values[tick];
+    });
+    toggleButton.addEventListener('click', () => {
+      open = !open;
+      renderDetails();
+    });
+    // Enable transitions after the initial closed state has painted.
+    requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add('is-ready')));
+  </script>
+</body>
+</html>
